# Production server image — multi-stage uv build. The builder installs the
# locked dependency set into /app/.venv; the final stage is a slim CPython
# image carrying only that venv (no uv, no compilers, no dev deps, non-root).
# The venv's python symlinks point at /usr/local/bin/python3.13, which exists
# at the same path in the final image (the documented uv Docker pattern).
# Build context: repo root; server/pyproject.toml + server/uv.lock are the
# required manifests.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm AS build

# copy (not hardlink) so the cross-stage COPY stays plain; bytecode-compile
# for faster cold starts.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Manifests first: the dependency layer caches while only source churns.
# --no-install-project skips building the guide package itself here.
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY server/ ./
# Second sync installs the guide package into the venv as a static (built)
# copy — the final image runs the package from the venv alone (the one
# source it still carries is the migration tree; see the runtime stage).
RUN uv sync --locked --no-dev --no-editable

FROM python:3.13-slim-bookworm

# Non-root runtime user (least privilege).
RUN groupadd --system guide && useradd --system --gid guide --create-home guide

WORKDIR /app
COPY --from=build --chown=guide:guide /app/.venv /app/.venv
# Migration assets: the startup migration resolves the repo checkout from
# the module — which, in this image, is the venv's site-packages with no
# alembic tree beside it — so the SAME single tree (server/alembic.ini +
# server/alembic/) ships here at the WORKDIR, root-owned and therefore
# read-only to the app user; guide/data/db/lifecycle.py falls back to it.
COPY server/alembic.ini ./alembic.ini
COPY server/alembic ./alembic

ENV PATH="/app/.venv/bin:$PATH"

USER guide
EXPOSE 8000
# Graceful shutdown: in-flight requests get 30s to drain before exit.
CMD ["uvicorn", "guide.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "30"]
