# Python virtualenvs + bytecode (any depth — server/.venv/, __pycache__/)
.venv/
__pycache__/
# Python tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Packaging artifacts
*.egg-info/
# JS installs & build output
node_modules/
dist/
# Env files stay out of git — EXCEPT the committed non-secrets: the
# placeholder template the deploy materializes the real file from, the
# single non-sensitive compose interpolation variable (IMAGE_TAG=ci), and
# the client build-env template (public-by-design Umami placeholders).
.env*
!server/.env.production.example
!client/.env.example
!.docker/.env
# Test coverage (pytest / Vitest HTML reports)
coverage/
# Topic 26 (files-media): the file store's runtime home — uploaded bytes and
# metadata sidecars are runtime data, never source (server/data/).
server/data/
*.log
# OS
.DS_Store
# IDE dirs
.idea/
*.iml
.vscode/
# In-container flock targets for verification runs (runtime artifacts)
.verify.lock
# Playwright e2e artifacts (host-run suite in e2e/ — reports + browser cache)
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/
.zcode/
