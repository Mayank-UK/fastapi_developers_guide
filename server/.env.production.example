# Template for the production environment file. The real
# server/.env.production is NOT committed — the deploy workflow materializes
# it on the VM from the PROD_ENV_B64 secret stored in the GitHub
# "production" environment:
#   base64 < server/.env.production | gh secret set PROD_ENV_B64 --env production
#
# The placeholder values below must BOOT the real app outside dev: the
# server's AppConfig validator refuses the dev-default signing secrets in
# any non-dev env, so FDG_JWT_SECRET / FDG_SESSION_SECRET carry long
# placeholder strings (32+ chars, distinct) that pass that check while
# being clearly non-secret. All three values are consumed by COMPOSE rails
# (the platform's POSTGRES_PASSWORD plus the app stack's FDG_DATABASE_URL /
# FDG_JWT_SECRET / FDG_SESSION_SECRET required-variable interpolations) —
# the deploy/CI shell sources this file before any `docker compose`
# command, so the database, the compose rails, and the app agree on one
# set of values by construction.
FDG_DB_PASSWORD=placeholder-db-password-not-a-secret-ci-and-docs-only
FDG_JWT_SECRET=placeholder-jwt-signing-secret-32-chars-not-a-secret
FDG_SESSION_SECRET=placeholder-session-signing-secret-32-chars-not-a-secret

# FDG_ENV / FDG_DATABASE_URL / FDG_REDIS_URL / FDG_MONGO_URL stay unset in
# this FILE on purpose — docker-compose.prod.yml supplies them via its
# environment: block, which beats env_file, pointing at the platform
# datastores by network alias.
